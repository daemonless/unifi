#!/bin/sh
# MongoDB rcd unit for UniFi

# Ensure db directory exists with proper permissions
mkdir -p /config/db /var/run/mongodb
chown -R bsd:bsd /config/db /var/run/mongodb

echo "Starting MongoDB for UniFi..."
exec dsu bsd /usr/local/bin/mongod \
    --dbpath /config/db \
    --port 27117 \
    --unixSocketPrefix /var/run/mongodb \
    --bind_ip 127.0.0.1
